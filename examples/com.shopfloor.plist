<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps the web interface and the scheduler alive on macOS.
  Copy to ~/Library/LaunchAgents/com.shopfloor.plist, fix the two paths,
  then: launchctl load -w ~/Library/LaunchAgents/com.shopfloor.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shopfloor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/CHANGEME/Developer/shopfloor/bin/shopfloor.mjs</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/CHANGEME/.shopfloor/serve.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/CHANGEME/.shopfloor/serve.err.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/CHANGEME/Developer/shopfloor</string>
</dict>
</plist>
